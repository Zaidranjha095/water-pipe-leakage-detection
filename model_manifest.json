{
  "task": "audio-classification",
  "framework": "pytorch",
  "architecture": "spectrogram_cnn",
  "weights": "weights/model.pth",
  "onnx": "weights/model.onnx",
  "config": "weights/config.json",
  "classes": "weights/class_names.json",
  "metrics": "outputs/metrics.json",
  "site_weights": "downloads/model.pth",
  "site_onnx": "downloads/model.onnx",
  "site_config": "downloads/config.json",
  "site_classes": "downloads/class_names.json",
  "site_metrics": "downloads/metrics.json",
  "site_note": "prepare_site.js copies the weights/ files into web/downloads/ for the static Vercel page. The browser loads site_onnx. GitHub evaluators should open the weights/ paths.",
  "predict": "python predict.py --audio <path>",
  "build_model": "model.py:build_model",
  "sample_rate": 16000,
  "duration": 1.0,
  "n_mels": 64,
  "n_fft": 1024,
  "hop_length": 256,
  "n_frames": 59,
  "class_order": [
    "leak",
    "no_leak",
    "environmental_noise"
  ],
  "output": "logits"
}
